      }
    },
    {
      "id": "$pin",
      "doc": "Receives Slack pin events: added and removed.",
      "type": {
        "name": "PinService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$reaction",
      "doc": "Receives Slack reaction events: added and removed.",
      "type": {
        "name": "ReactionService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$star",
