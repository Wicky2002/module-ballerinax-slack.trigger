{
  "version": "v1.0",
  "listeners": [
    {
      "id": "$listener",
      "doc": "Webhook listener that dispatches each inbound Slack webhook event to the concrete service type matching its event family.",
      "type": {
        "name": "Listener"
      },
      "services": [
        "$app",
        "$channel",
        "$dnd",
        "$emailDomainChanged",
        "$emojiChanged",
        "$file",
        "$gridMigration",
        "$group",
        "$im",
        "$linkShared",
        "$member",
        "$message",
        "$pin",
        "$reaction",
        "$star",
        "$subteam",
        "$team",
        "$tokensRevoked",
        "$userChange",
        "$assistant",
        "$call",
        "$entity",
        "$function",
        "$invite",
        "$sharedChannel",
        "$user",
        "$agent"
      ],
      "multipleServicesAllowed": true,
      "multipleServicesOfSameTypeAllowed": false
    }
  ],
  "serviceTypes": [
    {
      "id": "$app",
      "doc": "Receives Slack app events: mention, uninstalled, context changed, deleted, home opened, installed, requested, and uninstalled team.",
      "type": {
        "name": "AppService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$channel",
      "doc": "Receives Slack channel events: archive, created, deleted, history changed, left, rename, id changed, shared, and unshared.",
      "type": {
        "name": "ChannelService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$dnd",
      "doc": "Receives Slack do not disturb events: updated and updated user.",
      "type": {
        "name": "DndService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$emailDomainChanged",
      "doc": "Receives Slack email domain changed events.",
      "type": {
        "name": "EmailDomainChangedService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$emojiChanged",
      "doc": "Receives Slack emoji changed events.",
      "type": {
        "name": "EmojiChangedService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$file",
      "doc": "Receives Slack file events: change, comment deleted, created, deleted, public, shared, and unshared.",
      "type": {
        "name": "FileService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$gridMigration",
      "doc": "Receives Slack grid migration events: finished and started.",
      "type": {
        "name": "GridMigrationService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$group",
      "doc": "Receives Slack group events: close, history changed, left, open, rename, and deleted.",
      "type": {
        "name": "GroupService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$im",
      "doc": "Receives Slack direct message events: close, created, history changed, and open.",
      "type": {
        "name": "ImService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
