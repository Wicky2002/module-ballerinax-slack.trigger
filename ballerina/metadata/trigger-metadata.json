      }
    },
    {
      "id": "$member",
      "doc": "Receives Slack member events: joined channel and left channel.",
      "type": {
        "name": "MemberService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$message",
      "doc": "Receives Slack message events: message, metadata deleted, metadata posted, and metadata updated.",
      "type": {
        "name": "MessageService"
      },
